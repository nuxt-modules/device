{
    "name": "@nuxtjs/device",
    "version": "4.0.0",
    "description": "Device detection module for Nuxt",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuxt-modules/device.git"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./.nuxt/module-builder/types.d.mts",
            "import": "./src/module.ts"
        },
        "./runtime/*": {
            "types": "./src/runtime/*.ts",
            "import": "./src/runtime/*.ts"
        }
    },
    "main": "./src/module.ts",
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/types.d.mts",
                "import": "./dist/module.mjs"
            },
            "./runtime/*": {
                "types": "./dist/runtime/*.d.ts",
                "import": "./dist/runtime/*.js"
            }
        },
        "main": "./dist/module.mjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "nuxt-module-build prepare && tsdown",
        "dev": "nuxi dev playground",
        "dev:build": "nuxi build playground",
        "dev:prepare": "nuxt-module-build prepare && nuxi prepare playground && pnpm -C playground-v5 exec nuxt prepare",
        "dev:v5": "pnpm -C playground-v5 exec nuxt dev",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "prepack": "nuxt-module-build prepare && tsdown",
        "test": "vitest run",
        "test:types": "vue-tsc -b --noEmit && vue-tsc -b playground --noEmit",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "@nuxt/kit": "^4.7.0"
    },
    "devDependencies": {
        "@nuxt/devtools": "latest",
        "@nuxt/eslint-config": "^1.17.0",
        "@nuxt/module-builder": "2.0.0-alpha.1",
        "@nuxt/schema": "^4.7.0",
        "@nuxt/test-utils": "^4.4.0",
        "@vue/test-utils": "^2.5.1",
        "crawler-user-agents": "^1.66.0",
        "eslint": "^10.14.0",
        "happy-dom": "^21.0.4",
        "nuxt": "^4.7.0",
        "playwright-core": "^1.65.0",
        "tsdown": "^0.23.7",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=26.13.1",
            "onFail": "download"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.18.0",
            "onFail": "download"
        }
    }
}