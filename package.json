{
    "name": "@nuxtjs/device",
    "version": "5.0.0",
    "description": "Device detection module for Nuxt",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuxt-modules/device.git"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        },
        "./runtime/*": {
            "types": "./dist/runtime/*.d.mts",
            "import": "./dist/runtime/*.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "typesVersions": {
        "*": {
            ".": [
                "./dist/types.d.mts"
            ],
            "runtime/*": [
                "./dist/runtime/*.d.mts"
            ]
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "nuxt-module-build prepare && nuxt-module-build build",
        "dev": "nuxi dev playground",
        "dev:build": "nuxi build playground",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && pnpm -C playground-v5 exec nuxt prepare",
        "dev:v5": "pnpm -C playground-v5 exec nuxt dev",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "prepack": "pnpm build",
        "test": "vitest run",
        "test:types": "vue-tsc --noEmit && vue-tsc -b playground --noEmit",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "@nuxt/kit": "^4.6.4"
    },
    "devDependencies": {
        "@nuxt/devtools": "latest",
        "@nuxt/eslint-config": "^1.17.0",
        "@nuxt/module-builder": "^1.0.4",
        "@nuxt/test-utils": "^4.4.0",
        "@vue/test-utils": "^2.5.1",
        "crawler-user-agents": "^1.66.0",
        "eslint": "^10.14.0",
        "happy-dom": "^21.0.4",
        "nuxt": "^4.6.4",
        "playwright-core": "^1.65.0",
        "typescript": "^6.0.3",
        "unbuild": "^3.6.1",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=26.13.1",
            "onFail": "download"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.18.0",
            "onFail": "download"
        }
    }
}